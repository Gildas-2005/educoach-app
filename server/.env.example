# ============================================================================
# Educoach API — variables d'environnement (modèle, AUCUNE valeur secrète ici)
# Copier en `.env` en local. Sur Render, renseigner ces variables dans le
# dashboard (ou via l'API) ; DATABASE_URL est injecté automatiquement depuis la
# liaison Postgres du blueprint.
# ============================================================================

NODE_ENV=development
PORT=8080

# Base de données Postgres (Render : External Database URL ou internal).
DATABASE_URL=postgres://user:password@host:5432/educoach

# Secret de signature JWT — générer une valeur longue et aléatoire, e.g. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Coût bcrypt (12 = bon compromis sécurité/perf).
BCRYPT_ROUNDS=12

# Origines autorisées (CORS), séparées par des virgules (le front Render).
CORS_ORIGINS=http://localhost:8080,https://educoach.onrender.com
